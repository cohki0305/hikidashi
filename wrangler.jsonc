{
  "name": "hikidashi",
  "main": "server/entry/worker.ts",
  // cohki0305 のアカウント。ログイン中に複数のアカウントが見えても、ここに出す。
  "account_id": "<アカウント ID>",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // workers.dev の URL で公開する（独自ドメインは使わない）。プレビュー用の URL は作らない。
  "workers_dev": true,
  "preview_urls": false,
  // Cloudflare Access の JWT 検証に使う。値は本番の Access アプリに合わせて差し替える。
  "vars": {
    // Access のチームの URL。例: https://<チーム名>.cloudflareaccess.com
    "ACCESS_TEAM_DOMAIN": "https://<チーム名>.cloudflareaccess.com",
    // Access アプリの AUD（アプリの概要に出る Audience タグ）。ホスト全体を守るアプリの値を入れる（Bypass のアプリの値ではない）。
    "ACCESS_AUD": "<Access アプリの AUD>",
    // OAuth と MCP の入口が名乗る自分の URL。デプロイ後の URL を入れる。
    // 例: https://hikidashi.<サブドメイン>.workers.dev（末尾の / は付けない）。未設定ならそれらの入口は載せない（404）。
    "APP_URL": "https://hikidashi.<サブドメイン>.workers.dev",
    // R2 の S3 互換 API の署名に使う。Cloudflare のアカウント ID を入れる（R2 の画面に出る）。
    // キー（R2_ACCESS_KEY_ID・R2_SECRET_ACCESS_KEY）は Worker のシークレット。
    "R2_ACCOUNT_ID": "<アカウント ID>",
    // zip を置く R2 バケットの名前。デプロイのときに作る hikidashi-skills を入れる。
    "R2_BUCKET_NAME": "hikidashi-skills"
  },
  // D1 はスキルのメタデータ、R2 は版の zip を置く。database_id は本番の D1 を作ったときに差し替える。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hikidashi",
      "database_id": "<D1 の ID>",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "SKILLS",
      "bucket_name": "hikidashi-skills"
    }
  ],
  // 期限切れのアップロードの受け皿を掃除する（1 時間ごと）。
  "triggers": {
    "crons": ["17 * * * *"]
  },
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "html_handling": "none",
    "binding": "ASSETS",
    // 画面の無い道に 404 を返すため、配るファイルの道のほかは Worker を先に通す（server/entry/pages.ts）。
    "run_worker_first": [
      "/*",
      "!/assets/*",
      "!/images/*",
      "!/favicon.svg",
      "!/favicon.ico",
      "!/favicon-32.png",
      "!/apple-touch-icon.png",
      "!/robots.txt"
    ]
  }
}
