{
  "name": "hikidashi",
  "main": "server/entry/worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // Cloudflare Access の JWT 検証に使う。値は本番の Access アプリに合わせて差し替える。
  "vars": {
    "ACCESS_TEAM_DOMAIN": "https://hikidashi.cloudflareaccess.com",
    "ACCESS_AUD": "<あとで設定する>",
    // OAuth と MCP の入口が名乗る自分の URL。未設定ならそれらの入口は載せない（404）。
    "APP_URL": "<あとで設定する>"
  },
  // D1 はスキルのメタデータ、R2 は版の zip を置く。database_id は本番の D1 を作ったときに差し替える。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hikidashi",
      "database_id": "<あとで作る>",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "SKILLS",
      "bucket_name": "hikidashi-skills"
    }
  ],
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "html_handling": "none",
    "binding": "ASSETS",
    // 画面の無い道に 404 を返すため、配るファイルの道のほかは Worker を先に通す（server/entry/pages.ts）。
    "run_worker_first": [
      "/*",
      "!/assets/*",
      "!/images/*",
      "!/favicon.svg",
      "!/favicon.ico",
      "!/favicon-32.png",
      "!/apple-touch-icon.png",
      "!/robots.txt"
    ]
  }
}
