{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "none",
      "semicolons": "always"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noNonNullAssertion": "off"
      },
      "a11y": {
        "useButtonType": "off"
      },
      "suspicious": {
        "noArrayIndexKey": "off"
      }
    }
  },
  "files": {
    "includes": [
      "**",
      "!!**/node_modules",
      "!!**/build",
      "!!**/dist",
      "!!drizzle",
      "!!.wrangler",
      "!!.pipeline",
      "!!docs/design/mock",
      "!!docs/superpowers/specs/2026-11-11-teamskill-design.md",
      "!.dependency-cruiser.cjs",
      "!worker-configuration.d.ts",
      "!app/routeTree.gen.ts",
      "!tests/fixtures"
    ]
  }
}
