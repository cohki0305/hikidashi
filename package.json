{
  "name": "hikidashi",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:deps": "depcruise . --config .dependency-cruiser.cjs",
    "lint:custom": "bun run scripts/lint-runner.ts",
    "lint:boundary": "bun run scripts/lint-runner.ts lint:boundary",
    "lint:import-alias": "bun run scripts/lint-runner.ts lint:import-alias",
    "lint:lib-layout": "bun run scripts/lint-runner.ts lint:lib-layout",
    "lint:test-colocate": "bun run scripts/lint-runner.ts lint:test-colocate",
    "lint:no-bun-runtime": "bun run scripts/lint-runner.ts lint:no-bun-runtime",
    "lint:no-fixture-runtime-import": "bun run scripts/lint-runner.ts lint:no-fixture-runtime-import",
    "lint:derived-types": "bun run scripts/lint-runner.ts lint:derived-types",
    "lint:no-type-program": "bun run scripts/lint-runner.ts lint:no-type-program",
    "lint:docs-refs": "bun run scripts/lint-runner.ts lint:docs-refs",
    "lint:hono-style": "bun run scripts/lint-runner.ts lint:hono-style",
    "lint:route-rest": "bun run scripts/lint-runner.ts lint:route-rest",
    "lint:api-contract": "bun run scripts/lint-runner.ts lint:api-contract",
    "lint:layer-class": "bun run scripts/lint-runner.ts lint:layer-class",
    "lint:services": "bun run scripts/lint-runner.ts lint:services",
    "lint:drift": "bun run scripts/lint-runner.ts lint:drift",
    "lint:repo-single-table": "bun run scripts/lint-runner.ts lint:repo-single-table",
    "lint:no-throw": "bun run scripts/lint-runner.ts lint:no-throw",
    "lint:no-route-type-cast": "bun run scripts/lint-runner.ts lint:no-route-type-cast",
    "lint:schema-location": "bun run scripts/lint-runner.ts lint:schema-location",
    "lint:db-access": "bun run scripts/lint-runner.ts lint:db-access",
    "lint:drizzle-migrations": "bun run scripts/lint-runner.ts lint:drizzle-migrations",
    "lint:all": "bun run lint && bun run lint:deps && bun run lint:custom",
    "typecheck": "wrangler types && tsc --noEmit",
    "test": "bun test",
    "dev": "vite",
    "build": "vite build",
    "dev:seed": "bun run scripts/dev/seed-local.ts",
    "dev:server": "wrangler dev",
    "deploy": "HIKIDASHI_WRANGLER_CONFIG=wrangler.production.jsonc vite build && wrangler deploy",
    "db:migrate:prod": "wrangler d1 migrations apply hikidashi --remote --config wrangler.production.jsonc",
    "cf:types": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "postinstall": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@cloudflare/vite-plugin": "^1.64.0",
    "@happy-dom/global-registrator": "^21.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.46",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.4.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "dependency-cruiser": "^18.6.0",
    "drizzle-kit": "^0.31.8",
    "fflate": "^0.8.3",
    "happy-dom": "^21.0.1",
    "lefthook": "^2.2.2",
    "oxc-parser": "^0.154.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "wrangler": "^4.151.0"
  },
  "dependencies": {
    "@hono/zod-validator": "0.9.1",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-router": "^1.170.44",
    "aws4fetch": "^1.0.20",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.13.13",
    "jose": "^6.2.17",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
